generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ResourceType {
  LECTURE_NOTE
  TEXTBOOK
  PAST_QUESTION
  SOLUTION
  LAB_MANUAL
  PROGRAMMING_EXERCISE
  OTHER
}

enum ResourceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
  MODERATOR
  CONTRIBUTOR
  STUDENT
}

enum ModerationActionType {
  APPROVED
  REJECTED
  RESUBMITTED
  REMOVED
}

model University {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  slug        String            @unique
  countryCode String            @default("NG") @db.Char(2)
  status      RecordStatus      @default(ACTIVE)
  faculties   Faculty[]
  sessions    AcademicSession[]
  roleAssignments RoleAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model User {
  id                 String                @id @default(uuid()) @db.Uuid
  email              String                @unique
  displayName        String
  passwordHash       String
  status             UserStatus            @default(ACTIVE)
  roleAssignments    RoleAssignment[]      @relation("RoleSubject")
  grantsMade         RoleAssignment[]      @relation("RoleGrantor")
  sessions           AuthSession[]
  resources          Resource[]            @relation("ResourceUploader")
  moderationActions  ModerationAction[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, createdAt])
}

model RoleAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation("RoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role          UserRole
  universityId  String?     @db.Uuid
  university    University? @relation(fields: [universityId], references: [id], onDelete: Restrict)
  scopeKey      String
  grantedById   String?     @db.Uuid
  grantedBy     User?       @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@unique([userId, role, scopeKey])
  @@index([role, universityId])
  @@index([grantedById])
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  csrfTokenHash  String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Faculty {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  name         String
  slug         String
  departments  Department[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([universityId, slug])
  @@index([universityId])
}

model Department {
  id         String      @id @default(uuid()) @db.Uuid
  facultyId  String      @db.Uuid
  faculty    Faculty     @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  name       String
  slug       String
  programmes Programme[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([facultyId, slug])
  @@index([facultyId])
}

model Programme {
  id            String             @id @default(uuid()) @db.Uuid
  departmentId  String             @db.Uuid
  department    Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name          String
  slug          String
  award         String?
  durationYears Int?
  status        RecordStatus       @default(ACTIVE)
  levels        ProgrammeLevel[]
  sessions      ProgrammeSession[]
  courses       Course[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([departmentId, slug])
  @@index([departmentId])
}

model AcademicSession {
  id             String             @id @default(uuid()) @db.Uuid
  universityId   String             @db.Uuid
  university     University         @relation(fields: [universityId], references: [id], onDelete: Restrict)
  label          String
  startDate      DateTime?          @db.Date
  endDate        DateTime?          @db.Date
  programmes     ProgrammeSession[]
  courseOffering CourseOffering[]
  resources      Resource[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([universityId, label])
  @@index([universityId])
}

model ProgrammeSession {
  programmeId       String          @db.Uuid
  programme         Programme       @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  academicSessionId String          @db.Uuid
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())

  @@id([programmeId, academicSessionId])
  @@index([academicSessionId])
}

model ProgrammeLevel {
  id          String     @id @default(uuid()) @db.Uuid
  programmeId String     @db.Uuid
  programme   Programme  @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  label       String?
  ordinal     Int
  semesters   Semester[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([programmeId, code])
  @@unique([programmeId, ordinal])
}

model Semester {
  id               String           @id @default(uuid()) @db.Uuid
  programmeLevelId String           @db.Uuid
  programmeLevel   ProgrammeLevel   @relation(fields: [programmeLevelId], references: [id], onDelete: Restrict)
  code             String
  label            String
  ordinal          Int
  offerings        CourseOffering[]
  resources        Resource[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([programmeLevelId, code])
  @@unique([programmeLevelId, ordinal])
}

model Course {
  id          String           @id @default(uuid()) @db.Uuid
  programmeId String           @db.Uuid
  programme   Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  title       String
  description String?
  creditUnits Int?
  status      RecordStatus     @default(ACTIVE)
  offerings   CourseOffering[]
  resources   Resource[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([programmeId, code])
  @@index([programmeId])
  @@index([title])
}

model CourseOffering {
  courseId          String          @db.Uuid
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semesterId        String          @db.Uuid
  semester          Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  academicSessionId String          @db.Uuid
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())

  @@id([courseId, semesterId, academicSessionId])
  @@index([semesterId, academicSessionId])
}

model Resource {
  id                String                 @id @default(uuid()) @db.Uuid
  courseId          String                 @db.Uuid
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicSessionId String?                @db.Uuid
  academicSession   AcademicSession?       @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  semesterId        String?                @db.Uuid
  semester          Semester?              @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  title             String
  description       String?
  type              ResourceType
  status            ResourceApprovalStatus @default(PENDING)
  uploadedById      String?                @db.Uuid
  uploader          User?                  @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  file              ResourceFile?
  moderationActions ModerationAction[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([courseId, status, createdAt])
  @@index([academicSessionId, semesterId])
  @@index([type, status])
  @@index([uploadedById, status, createdAt])
}

model ModerationAction {
  id          String               @id @default(uuid()) @db.Uuid
  resourceId  String               @db.Uuid
  resource    Resource             @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  actorId     String               @db.Uuid
  actor       User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action      ModerationActionType
  reason      String?
  createdAt   DateTime             @default(now())

  @@index([resourceId, createdAt])
  @@index([actorId, createdAt])
}

model ResourceFile {
  id               String   @id @default(uuid()) @db.Uuid
  resourceId       String   @unique @db.Uuid
  resource         Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  provider         String
  storageKey       String
  originalFilename String
  mediaType        String
  byteSize         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, storageKey])
}
