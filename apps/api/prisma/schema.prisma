generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum ResourceType {
  LECTURE_NOTE
  TEXTBOOK
  PAST_QUESTION
  SOLUTION
  LAB_MANUAL
  PROGRAMMING_EXERCISE
  OTHER
}

enum ResourceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
  MODERATOR
  CONTRIBUTOR
  STUDENT
}

enum ModerationActionType {
  APPROVED
  REJECTED
  RESUBMITTED
  REMOVED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeletionReasonCategory {
  DUPLICATE
  INCORRECT_CLASSIFICATION
  WRONG_COURSE
  OUTDATED_MISLEADING
  CORRUPTED_FILE
  COPYRIGHT
  PRIVACY
  INAPPROPRIATE
  OTHER
}

enum ResourceTrashMethod {
  SUPER_ADMIN_DIRECT
  APPROVED_REQUEST
}

enum PurgeJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETE
  CANCELLED
}

enum ResourceReportCategory {
  BROKEN_FILE
  WRONG_CONTENT
  COPYRIGHT
  PRIVACY
  INAPPROPRIATE
  OTHER
}

enum ResourceReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum PreferredResourceKind {
  TEXTBOOK
  LECTURE_NOTE
  PAST_QUESTION
  SLIDES
  WORKED_SOLUTION
  LAB_MANUAL
  PROGRAMMING_EXERCISE
  PROJECT
}

enum LearningInterest {
  PROGRAMMING
  AI
  ELECTRONICS
  TELECOMMUNICATIONS
  ROBOTICS
  MATHEMATICS
}

enum LearningGoal {
  EXAM_PREPARATION
  CONCEPT_MASTERY
  PROJECT_BUILDING
  RESEARCH
}

model University {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  slug        String            @unique
  countryCode String            @default("NG") @db.Char(2)
  status      RecordStatus      @default(ACTIVE)
  faculties   Faculty[]
  sessions    AcademicSession[]
  roleAssignments RoleAssignment[]
  academicProfiles AcademicProfile[] @relation("AcademicProfileUniversity")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model User {
  id                 String                @id @default(uuid()) @db.Uuid
  email              String                @unique
  displayName        String
  passwordHash       String
  status             UserStatus            @default(ACTIVE)
  emailVerifiedAt    DateTime?
  roleAssignments    RoleAssignment[]      @relation("RoleSubject")
  grantsMade         RoleAssignment[]      @relation("RoleGrantor")
  sessions           AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  academicProfile    AcademicProfile?
  profile            UserProfile?
  preferences        UserPreferences?
  resources          Resource[]            @relation("ResourceUploader")
  moderationActions  ModerationAction[]
  governanceInboxState GovernanceInboxState?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, createdAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model RoleAssignment {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  user          User        @relation("RoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role          UserRole
  universityId  String?     @db.Uuid
  university    University? @relation(fields: [universityId], references: [id], onDelete: Restrict)
  scopeKey      String
  grantedById   String?     @db.Uuid
  grantedBy     User?       @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@unique([userId, role, scopeKey])
  @@index([role, universityId])
  @@index([grantedById])
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  csrfTokenHash  String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Faculty {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @db.Uuid
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  name         String
  slug         String
  departments  Department[]
  academicProfiles AcademicProfile[] @relation("AcademicProfileFaculty")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([universityId, slug])
  @@index([universityId])
}

model Department {
  id         String      @id @default(uuid()) @db.Uuid
  facultyId  String      @db.Uuid
  faculty    Faculty     @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  name       String
  slug       String
  programmes Programme[]
  academicProfiles AcademicProfile[] @relation("AcademicProfileDepartment")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([facultyId, slug])
  @@index([facultyId])
}

model Programme {
  id            String             @id @default(uuid()) @db.Uuid
  departmentId  String             @db.Uuid
  department    Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  name          String
  slug          String
  award         String?
  durationYears Int?
  status        RecordStatus       @default(ACTIVE)
  levels        ProgrammeLevel[]
  sessions      ProgrammeSession[]
  courses       Course[]
  academicProfiles AcademicProfile[] @relation("AcademicProfileProgramme")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([departmentId, slug])
  @@index([departmentId])
}

model AcademicSession {
  id             String             @id @default(uuid()) @db.Uuid
  universityId   String             @db.Uuid
  university     University         @relation(fields: [universityId], references: [id], onDelete: Restrict)
  label          String
  startDate      DateTime?          @db.Date
  endDate        DateTime?          @db.Date
  programmes     ProgrammeSession[]
  courseOffering CourseOffering[]
  resources      Resource[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([universityId, label])
  @@index([universityId])
}

model ProgrammeSession {
  programmeId       String          @db.Uuid
  programme         Programme       @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  academicSessionId String          @db.Uuid
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())

  @@id([programmeId, academicSessionId])
  @@index([academicSessionId])
}

model ProgrammeLevel {
  id          String     @id @default(uuid()) @db.Uuid
  programmeId String     @db.Uuid
  programme   Programme  @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  label       String?
  ordinal     Int
  semesters   Semester[]
  academicProfiles AcademicProfile[] @relation("AcademicProfileLevel")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([programmeId, code])
  @@unique([programmeId, ordinal])
}

model Semester {
  id               String           @id @default(uuid()) @db.Uuid
  programmeLevelId String           @db.Uuid
  programmeLevel   ProgrammeLevel   @relation(fields: [programmeLevelId], references: [id], onDelete: Restrict)
  code             String
  label            String
  ordinal          Int
  offerings        CourseOffering[]
  academicProfiles AcademicProfile[] @relation("AcademicProfileSemester")
  resources        Resource[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([programmeLevelId, code])
  @@unique([programmeLevelId, ordinal])
}

model AcademicProfile {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @unique @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId      String?         @db.Uuid
  university        University?     @relation("AcademicProfileUniversity", fields: [universityId], references: [id], onDelete: SetNull)
  facultyId         String?         @db.Uuid
  faculty           Faculty?        @relation("AcademicProfileFaculty", fields: [facultyId], references: [id], onDelete: SetNull)
  departmentId      String?         @db.Uuid
  department        Department?     @relation("AcademicProfileDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  programmeId       String?         @db.Uuid
  programme         Programme?      @relation("AcademicProfileProgramme", fields: [programmeId], references: [id], onDelete: SetNull)
  currentLevelId    String?         @db.Uuid
  currentLevel      ProgrammeLevel? @relation("AcademicProfileLevel", fields: [currentLevelId], references: [id], onDelete: SetNull)
  currentSemesterId String?         @db.Uuid
  currentSemester   Semester?       @relation("AcademicProfileSemester", fields: [currentSemesterId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([universityId])
  @@index([departmentId])
  @@index([programmeId])
}

model UserProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username   String?  @unique
  avatarUrl  String?
  bio        String?
  githubUrl  String?
  linkedInUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserPreferences {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @unique @db.Uuid
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceKinds      PreferredResourceKind[] @default([])
  learningInterests  LearningInterest[]      @default([])
  learningGoals      LearningGoal[]           @default([])
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model Course {
  id          String           @id @default(uuid()) @db.Uuid
  programmeId String           @db.Uuid
  programme   Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  code        String
  title       String
  description String?
  creditUnits Int?
  isGeneralEngineering Boolean @default(false)
  status      RecordStatus     @default(ACTIVE)
  offerings   CourseOffering[]
  resources   Resource[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([programmeId, code])
  @@index([programmeId])
  @@index([title])
}

model CourseOffering {
  courseId          String          @db.Uuid
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semesterId        String          @db.Uuid
  semester          Semester        @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  academicSessionId String          @db.Uuid
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now())

  @@id([courseId, semesterId, academicSessionId])
  @@index([semesterId, academicSessionId])
}

model Resource {
  id                String                 @id @default(uuid()) @db.Uuid
  courseId          String                 @db.Uuid
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicSessionId String?                @db.Uuid
  academicSession   AcademicSession?       @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  semesterId        String?                @db.Uuid
  semester          Semester?              @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  title             String
  description       String?
  type              ResourceType
  status            ResourceApprovalStatus @default(PENDING)
  sourceAttribution String?
  tags              String[]               @default([])
  trashedAt         DateTime?
  trashExpiresAt    DateTime?
  trashGeneration   String?                @db.Uuid
  trashedById       String?                @db.Uuid
  trashReason       String?
  trashMethod       ResourceTrashMethod?
  statusBeforeTrash ResourceApprovalStatus?
  quarantinedAt     DateTime?
  quarantinedById   String?                @db.Uuid
  quarantineReason  String?
  uploadedById      String?                @db.Uuid
  uploader          User?                  @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  file              ResourceFile?
  moderationActions ModerationAction[]
  deletionRequests  DeletionRequest[]
  governanceEvents  ResourceGovernanceEvent[]
  reports           ResourceReport[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([courseId, status, createdAt])
  @@index([academicSessionId, semesterId])
  @@index([type, status])
  @@index([uploadedById, status, createdAt])
  @@index([trashedAt, trashExpiresAt])
  @@index([quarantinedAt])
}

model ModerationAction {
  id          String               @id @default(uuid()) @db.Uuid
  resourceId  String?              @db.Uuid
  resourceIdSnapshot String        @db.Uuid
  resource    Resource?            @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  actorId     String               @db.Uuid
  actor       User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action      ModerationActionType
  reason      String?
  createdAt   DateTime             @default(now())

  @@index([resourceId, createdAt])
  @@index([resourceIdSnapshot, createdAt])
  @@index([actorId, createdAt])
}

model DeletionRequest {
  id                   String                 @id @default(uuid()) @db.Uuid
  resourceId           String?                @db.Uuid
  resourceIdSnapshot   String                 @db.Uuid
  universityIdSnapshot String                 @db.Uuid
  resource             Resource?              @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  requestedById        String                 @db.Uuid
  requestedByRole      String
  category             DeletionReasonCategory
  explanation          String
  status               DeletionRequestStatus  @default(PENDING)
  decidedById          String?                @db.Uuid
  decidedByRole        String?
  decidedAt            DateTime?
  decisionNote         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([resourceId, status])
  @@index([resourceIdSnapshot, createdAt])
  @@index([universityIdSnapshot, status, createdAt])
  @@index([requestedById, createdAt])
}

model ResourceGovernanceEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  resourceId         String?  @db.Uuid
  resourceIdSnapshot String   @db.Uuid
  resource           Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  actorId            String?  @db.Uuid
  actorRole          String?
  action             String
  fieldName          String?
  previousValue      Json?
  newValue           Json?
  reason             String?
  createdAt          DateTime @default(now())

  @@index([resourceIdSnapshot, createdAt])
  @@index([actorId, createdAt])
}

model ResourcePurgeJob {
  id                 String        @id @default(uuid()) @db.Uuid
  resourceIdSnapshot String        @db.Uuid
  trashGenerationSnapshot String   @unique @db.Uuid
  provider           String
  storageKey         String
  status             PurgeJobStatus @default(PENDING)
  attempts           Int           @default(0)
  lastError          String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([resourceIdSnapshot, status])
}

model GovernanceInboxState {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastViewedAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ResourceReport {
  id                 String                 @id @default(uuid()) @db.Uuid
  resourceId         String?                @db.Uuid
  resourceIdSnapshot String                 @db.Uuid
  resource           Resource?              @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  universityIdSnapshot String               @db.Uuid
  reporterId         String                 @db.Uuid
  reporterRole       String
  category           ResourceReportCategory
  explanation        String
  status             ResourceReportStatus   @default(OPEN)
  reviewedById       String?                @db.Uuid
  reviewedByRole     String?
  reviewedAt         DateTime?
  resolutionNote     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([resourceIdSnapshot, createdAt])
  @@index([universityIdSnapshot, status, createdAt])
  @@index([reporterId, createdAt])
}

model ResourceFile {
  id               String   @id @default(uuid()) @db.Uuid
  resourceId       String   @unique @db.Uuid
  resource         Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  provider         String
  storageKey       String
  originalFilename String
  mediaType        String
  byteSize         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, storageKey])
}
