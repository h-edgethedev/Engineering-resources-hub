# PostgreSQL must be installed and running locally; Docker is not required.
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/engineering_resources_hub?schema=public"

# API server
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
RESOURCE_STORAGE_DIR=./.data/uploads
RESOURCE_MAX_FILE_SIZE_BYTES=20971520

# Email verification (optional in development; required in production).
# Without SMTP settings in development, the API prints verification links to its console.
# EMAIL_SMTP_URL="smtps://username:replace-me@smtp.example.com:465"
# EMAIL_FROM="Engineering Resources Hub <no-reply@example.com>"
